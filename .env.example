# ⚠️  ÄLÄ LIITÄ OIKEAA AVAINTA TÄHÄN TIEDOSTOON.
#
# Tämä on malli, joka menee GitHubiin. Oikea avain kuuluu tiedostoon .env,
# joka on .gitignoressa ja pysyy vain omalla koneellasi:
#
#     cp .env.example .env      # ja liitä avain .env-tiedostoon
#
# Jos avain päätyy vahingossa tänne tai committiin: luo uusi avain ja poista
# vanha osoitteessa https://platform.claude.com → Settings → API keys.

# API-avain (valinnainen — ilman sitä käytetään mallipohjatekstejä)
ANTHROPIC_API_KEY=sk-ant-...

# --- Gmail-yhteys (valinnainen) ---
# Poimii sovitut keikat sähköposteista hyväksyntälistalle.
# GMAIL_APP_PASSWORD on Google-tilin sovellussalasana, EI tavallinen salasana:
# Google-tili → Turvallisuus → 2-vaiheinen vahvistus → Sovellussalasanat.
# GMAIL_USER=baari@gmail.com
# GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx

# Rajaa haun mahdollisimman tiukaksi — viestien teksti lähetetään Claudelle.
# GMAIL_MAILBOX=INBOX          # esim. "Keikat" jos käytät Gmail-tunnistetta
# GMAIL_SEARCH=keikka          # vain viestit, joiden tekstissä tämä sana
# GMAIL_DAYS=60                # kuinka monta päivää taaksepäin
# GMAIL_MAX=40                 # enintään näin monta viestiä kerralla

# Kokeilu ilman Gmail-tunnuksia: lue viestit JSON-tiedostosta
# ADDHELPER_MAIL_FIXTURE=./esimerkkipostit.json

# Valinnaiset
# ADDHELPER_MODEL=claude-opus-5
# PORT=4173
# ADDHELPER_DATA=./data
